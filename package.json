{
  "name": "dental-video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:api": "tsx scripts/run-api.ts",
    "stop:api": "tsx scripts/free-api-port.ts",
    "dev:web": "cd frontend && npm run dev",
    "build:web": "cd frontend && npm run build",
    "codegen": "cd frontend && npm run codegen",
    "install:all": "npm install && cd frontend && npm install",
    "typecheck": "npm run typecheck:scripts && npm run typecheck:web",
    "typecheck:scripts": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "cd frontend && npm run typecheck",
    "railway:help": "powershell -ExecutionPolicy Bypass -File scripts/railway-setup.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
