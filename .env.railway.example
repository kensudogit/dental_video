# Copy to .env.railway for local smoke test (do not commit .env.railway)
#
# Railway Dashboard ? service ? Variables

# --- Unified service (recommended, /railway.toml) ---
# Do NOT set API_URL — embedded Go API on 127.0.0.1:8081
# UNIFIED_DEPLOY=1  (set by Dockerfile.unified)

# --- PostgreSQL (Railway plugin ? reference as DATABASE_URL) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Required for login / SaaS ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# CORS_ORIGINS=https://YOUR-SERVICE.up.railway.app
# APP_PUBLIC_URL=https://YOUR-SERVICE.up.railway.app

# --- Two-service Web only ---
# API_URL=https://YOUR-API-SERVICE.up.railway.app
